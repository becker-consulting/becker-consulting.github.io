{
  "name": "becker-consulting.se",
  "private": true,
  "type": "module",
  "description": "Company website for Henrik Becker Consulting AB",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-fetch": "^6.0.1",
    "js-yaml": "^5.5.0",
    "markdown-it-anchor": "^10.0.0"
  },
  "overrides": {
    "gray-matter": {
      "js-yaml": {
        "argparse": "2.0.1"
      }
    }
  }
}
