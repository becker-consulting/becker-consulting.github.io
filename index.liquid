---
layout: base.liquid

hero:
  label: Henrik Becker Consulting AB · Lidingö
  intro: Senior .NET consultant and solutions architect in Stockholm. I design and build the backend the rest of your product stands on, and make sure it's still easy to change years later. Available for new assignments.
  cta: Get in touch
  secondary: What I work on
  photo_alt: Henrik Becker

services:
  heading: Services   # read by screen readers only
  # The cards themselves come from henrikbecker.net ("What I offer"), see _data/shared.js.

side_projects:
  label: Side projects
  heading: Things I build off the clock.
  intro: Small, real products — each one an excuse to try a stack properly and ship it.
  tech_label: Built with

blog_band:
  label: Blog
  heading: Writing is on its way.
  text: Notes on .NET, architecture and the side projects above — including the parts that went sideways.
  action: Coming soon
---
<div class="wrap">
  <section class="hero">
    <div class="hero__text">
      <div class="hero__id">
        <div class="hero__avatar">
          <picture>
            <source type="image/webp" srcset="/assets/img/henrik-becker-square.webp">
            <img src="/assets/img/henrik-becker-square.jpg" width="400" height="400" alt="" loading="lazy">
          </picture>
        </div>
        <div class="hero__heading">
          <p class="label">{{ hero.label | escape | replace: " AB", "&nbsp;AB" | replace: " · ", "&nbsp;· " }}</p>
          <h1>{{ site.tagline }}</h1>
        </div>
      </div>
      <p class="hero__intro">{{ hero.intro | escape }}</p>
      <div class="hero__actions">
        <a class="button" href="#contact" data-email="{{ site.email.user }}|{{ site.email.domain }}">{{ hero.cta | escape }} {% include "icon.liquid", name: "arrow" %}</a>
        <a class="link-underline" href="#services">{{ hero.secondary | escape }}</a>
      </div>
    </div>
    <div class="hero__photo">
      <picture>
        {%- comment -%} Hidden on mobile; point it at the avatar file so phones don't download the big photo. {%- endcomment %}
        <source media="(max-width: 900px)" type="image/webp" srcset="/assets/img/henrik-becker-square.webp">
        <source type="image/webp" srcset="/assets/img/henrik-becker-800.webp 800w, /assets/img/henrik-becker-1200.webp 1200w" sizes="(max-width: 900px) 100vw, 640px">
        <img src="/assets/img/henrik-becker-1200.jpg" srcset="/assets/img/henrik-becker-800.jpg 800w, /assets/img/henrik-becker-1200.jpg 1200w" sizes="(max-width: 900px) 100vw, 640px" width="1200" height="1125" alt="{{ hero.photo_alt | escape }}" fetchpriority="high">
      </picture>
    </div>
  </section>

  <section class="services" id="services" aria-labelledby="services-title">
    <h2 class="visually-hidden" id="services-title">{{ services.heading | escape }}</h2>
    {% for service in shared.services %}
    <div class="service">
      <span class="service__number">{{ forloop.index | prepend: "0" }}</span>
      <h3>{{ service.title | escape }}</h3>
      <p>{{ service.text | escape }}</p>
    </div>
    {% endfor %}
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section__head">
      <div>
        <p class="label">{{ side_projects.label | escape }}</p>
        <h2 id="projects-title">{{ side_projects.heading | escape }}</h2>
      </div>
      <p>{{ side_projects.intro | escape }}</p>
    </div>
    <div class="projects">
      {% for project in projects %}
      <a class="project" href="{{ project.url }}">
        <div class="project__top">
          <span class="project__name">{{ project.name }}</span>
          {% include "icon.liquid", name: "external" %}
        </div>
        <div class="project__domain">{{ project.domain }}{% if project.badge %}<span class="project__badge">{{ project.badge }}</span>{% endif %}</div>
        <p class="project__tagline">{{ project.tagline }}</p>
        <p class="project__description">{{ project.description }}</p>
        <ul class="chips" aria-label="{{ side_projects.tech_label | escape }}">
          {% for t in project.tech %}<li>{{ t }}</li>{% endfor %}
        </ul>
      </a>
      {% endfor %}
    </div>
  </section>

  {%- comment -%}
  Blog band — hidden until the blog (in its own repo) is live.
  Uncomment and point the action at the blog to bring it back.
  <section class="band" id="blog" aria-labelledby="blog-title">
    <div>
      <p class="label">{{ blog_band.label | escape }}</p>
      <h2 id="blog-title">{{ blog_band.heading | escape }}</h2>
      <p>{{ blog_band.text | escape }}</p>
    </div>
    <span class="band__action" aria-disabled="true">{{ blog_band.action | escape }}</span>
  </section>
  {%- endcomment %}
</div>
