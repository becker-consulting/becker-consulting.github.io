---
layout: base.liquid
title: CV
description: Short CV for Henrik Becker — senior .NET developer and solutions architect in Lidingö, Stockholm.
permalink: /cv/
---
<div class="wrap">
  <section class="cv-head">
    <div class="cv-head__id">
      <div class="cv-head__photo">
        <picture>
          <source type="image/webp" srcset="/assets/img/henrik-becker-square.webp">
          <img src="/assets/img/henrik-becker-square.jpg" width="400" height="400" alt="Henrik Becker">
        </picture>
      </div>
      <div class="cv-head__text">
        <p class="label">CV · Short version</p>
        <h1>{{ cv.name }}</h1>
        <p class="cv-head__title">{{ cv.title }} · {{ cv.location }}</p>
      </div>
    </div>
    <div class="cv-head__actions">
      <a class="button button--small" href="{{ cv.downloads.pdf }}">{% include "icon.liquid", name: "download" %} Full CV (PDF)</a>
      <a class="button button--ghost" href="{{ cv.downloads.pdf_sv }}" hreflang="sv" lang="sv">På svenska</a>
    </div>
  </section>

  <div class="cv-body">
    <div>
      <p class="cv-summary">{{ cv.summary }}</p>

      <h2 class="label">Selected experience</h2>
      {% for job in cv.experience %}
      <div class="cv-entry">
        <p class="cv-entry__years">{{ job.years }}</p>
        <div class="cv-entry__body">
          <h3 class="cv-entry__head"><span class="cv-entry__name">{{ job.name }}</span> <span class="cv-entry__role">{{ job.role }}</span></h3>
          <p class="cv-entry__summary">{{ job.summary }}</p>
          <p class="cv-entry__tech">{{ job.tech }}</p>
        </div>
      </div>
      {% endfor %}
      <div class="cv-entry cv-entry--earlier">
        <p class="cv-entry__years">{{ cv.earlier.years }}</p>
        <p>{{ cv.earlier.text }} — <a href="{{ cv.downloads.pdf }}">see the full CV</a>.</p>
      </div>

      <figure class="quote">
        {% include "icon.liquid", name: "quote" %}
        <blockquote>{{ cv.recommendation.quote }}</blockquote>
        <figcaption>{{ cv.recommendation.by }}</figcaption>
      </figure>
    </div>

    <aside class="cv-aside">
      <section>
        <h2 class="label">Core</h2>
        <ul>{% for item in cv.core %}<li>{{ item }}</li>{% endfor %}</ul>
      </section>
      <section>
        <h2 class="label">Certifications</h2>
        {% for c in cv.certifications %}<div class="cert"><span>{{ c.name }}</span><span>{{ c.issuer }} · {{ c.year }}</span></div>
        {% endfor %}
      </section>
      <section>
        <h2 class="label">Languages</h2>
        <ul>{% for l in cv.languages %}<li>{{ l }}</li>{% endfor %}</ul>
      </section>
      <section>
        <h2 class="label">Side projects</h2>
        {% for p in projects %}<a class="side-project" href="{{ p.url }}"><span>{{ p.name }}</span><span>{{ p.since }}</span></a>
        {% endfor %}
      </section>
      <section class="formats">
        <h2 class="label">Other formats</h2>
        <div>
          <a href="{{ cv.downloads.markdown }}">Markdown</a>
          <a href="{{ cv.downloads.text }}">Plain text</a>
        </div>
      </section>
    </aside>
  </div>
</div>
