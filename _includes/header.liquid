{% capture nav_links %}
  <a href="/#services">Services</a>
  <a href="/#projects">Projects</a>
  {%- comment %} Blog lives in its own repo; link it here when it's live.
  <a href="https://…">Blog</a>
  {% endcomment %}
  <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
  <a href="/cv/"{% if page.url == "/cv/" %} aria-current="page"{% endif %}>CV</a>
  <a class="nav-contact" href="#contact" data-email="{{ site.email.user }}|{{ site.email.domain }}">Contact</a>
{% endcapture %}
<header class="site-header{% if page.url != '/' %} site-header--ruled{% endif %}">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">b</span>
      <span>{{ site.title }}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {{ nav_links }}
    </nav>
    <details class="nav-mobile">
      <summary aria-label="Menu">
        {% include "icon.liquid", name: "menu" %}
      </summary>
      <nav class="nav-mobile__panel" aria-label="Main">
        {{ nav_links }}
      </nav>
    </details>
  </div>
</header>
