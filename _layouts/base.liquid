<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if title %}{% assign page_title = title | append: " · " | append: site.title %}{% else %}{% assign page_title = site.title | append: " · " | append: site.tagline %}{% endif %}
  {% assign page_description = description | default: site.description %}
  {% assign page_url = page.url | prepend: site.url %}
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  <meta name="author" content="{{ site.author }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <link rel="canonical" href="{{ page_url }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F2F1F1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#171517" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="{% if layout == 'post.liquid' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  <meta property="og:url" content="{{ page_url }}">
  <meta property="og:image" content="{{ site.image | prepend: site.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="google-adsense-account" content="{{ site.adsense }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ site.company | json }},
    "alternateName": {{ site.alternateName | json }},
    "url": {{ site.url | json }},
    "email": {{ site.email.user | append: "@" | append: site.email.domain | json }},
    "vatID": {{ site.vatNumber | json }},
    "identifier": { "@type": "PropertyValue", "propertyID": "Organisationsnummer", "value": {{ site.orgNumber | json }} },
    "foundingDate": {{ site.founded | json }},
    "address": { "@type": "PostalAddress", "addressLocality": "Lidingö", "addressCountry": "SE" },
    "founder": { "@type": "Person", "name": {{ site.author | json }}, "sameAs": [{{ site.github | json }}, {{ site.linkedin | json }}] }
  }
  </script>
  <link rel="icon" href="/favicon.ico" sizes="any">
  {% for size in favicon_sizes %}<link rel="icon" type="image/png" href="/assets/img/favicon{{ size }}x{{ size }}.png" sizes="{{ size }}x{{ size }}">
  {% endfor %}<link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "header.liquid" %}
  <main id="main">
    {{ content }}
  </main>
  {% include "footer.liquid" %}
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
