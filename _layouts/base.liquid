{%- assign lang = lang | default: "sv" -%}
{%- assign t = i18n[lang] -%}
{%- assign alternates = collections.all | translations: translationKey -%}
<!DOCTYPE html>
<html lang="{{ t.html_lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if title %}{% assign page_title = title | append: " · " | append: site.title %}{% else %}{% assign page_title = t.home_title %}{% endif %}
  {% assign page_description = description | default: t.description %}
  {% assign page_url = page.url | prepend: site.url %}
  {%- comment %} Front matter `canonical` points a page at its original elsewhere (the CV lives on henrikbecker.net). {%- endcomment %}
  {% assign canonical_url = canonical | default: page_url %}
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_description }}">
  <meta name="author" content="{{ site.author }}">
  {% if robots %}<meta name="robots" content="{{ robots }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {%- unless canonical %}{% for alt in alternates %}
  <link rel="alternate" hreflang="{{ i18n[alt.lang].hreflang }}" href="{{ alt.url | prepend: site.url }}">
  {%- if alt.lang == "en" %}
  <link rel="alternate" hreflang="x-default" href="{{ alt.url | prepend: site.url }}">
  {%- endif %}{% endfor %}{% endunless %}
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#F2F1F1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#171517" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ t.locale }}">
  {%- for alt in alternates %}{% if alt.lang != lang %}
  <meta property="og:locale:alternate" content="{{ i18n[alt.lang].locale }}">
  {%- endif %}{% endfor %}
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_description }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ site.image | prepend: site.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="google-adsense-account" content="{{ site.adsense }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ site.url | append: "/#organization" | json }},
    "name": {{ site.company | json }},
    "alternateName": {{ site.alternateName | json }},
    "url": {{ site.url | append: "/" | json }},
    "description": {{ t.description | json }},
    "logo": {{ "/assets/img/favicon512x512.png" | prepend: site.url | json }},
    "image": {{ site.image | prepend: site.url | json }},
    "sameAs": [{{ site.github | json }}, {{ site.linkedin | json }}],
    "email": {{ site.email.user | append: "@" | append: site.email.domain | json }},
    "vatID": {{ site.vatNumber | json }},
    "identifier": { "@type": "PropertyValue", "propertyID": "Organisationsnummer", "value": {{ site.orgNumber | json }} },
    "foundingDate": {{ site.founded | json }},
    "address": { "@type": "PostalAddress", "addressLocality": "Lidingö", "addressCountry": "SE" },
    "founder": { "@type": "Person", "@id": "https://www.henrikbecker.net/#person", "name": {{ site.author | json }}, "sameAs": [{{ site.github | json }}, {{ site.linkedin | json }}] }
  }
  </script>
  <link rel="icon" href="/favicon.ico" sizes="any">
  {% for size in favicon_sizes %}<link rel="icon" type="image/png" href="/assets/img/favicon{{ size }}x{{ size }}.png" sizes="{{ size }}x{{ size }}">
  {% endfor %}<link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/shared.css">
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  <a class="skip-link" href="#main">{{ t.skip }}</a>
  {% include "header.liquid" %}
  <main id="main">
    {{ content }}
  </main>
  {% include "footer.liquid" %}
  <script src="/assets/js/site.js" defer></script>
  <script src="/assets/js/toc.js" defer></script>
</body>
</html>
